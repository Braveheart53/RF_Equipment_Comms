+    @staticmethod
+    def _isHDF5File(filename):
+        """Whether filename is an HDF5 file, such as a .vszh5 document.
+
+        The 8-byte HDF5 signature is at offset 0, or at 512, 1024, 2048...
+        when the file starts with a user block.
+        """
+        signature = b'\x89HDF\r\n\x1a\n'
+        try:
+            with io.open(filename, 'rb') as f:
+                offset = 0
+                while True:
+                    f.seek(offset)
+                    head = f.read(8)
+                    if len(head) < 8:
+                        return False
+                    if head == signature:
+                        return True
+                    offset = 512 if offset == 0 else offset*2
+        except EnvironmentError:
+            return False
+

+# %% OPERATOR EVENT LOG (0.2.0)
+def events_path_for(capture_csv_path):
+    """<folder>/<capture stem>_events.csv next to the capture CSV."""
+    root, _extension = os.path.splitext(os.path.abspath(capture_csv_path))
+    return root + "_events.csv"
+
+
+class CaptureEventLog:
+    """Small CSV of operator events during a run, e.g. a trace reset.
+
+    One row per affected trace. The file is created (replacing one from an
+    earlier run) at the first event of a run and appended to afterwards;
+    a run without events leaves no file. Each record is flushed. Only the
+    acquisition worker writes, so no lock is needed across threads, but one
+    is kept to make misuse harmless.
+    """
+    FIELDS = ("timestamp_iso", "event", "screen", "trace", "original_mode",
+              "restored_mode", "ok", "note")
+
+    def __init__(self, capture_csv_path):
+        self.path = events_path_for(capture_csv_path)
+        self._started = False
+        self._lock = threading.Lock()
+        self.rows_written = 0
+
+    def record(self, instant, event, rows):
+        """Write one row per mapping in ``rows`` (keys as FIELDS, partial ok)."""
+        rows = list(rows) or [{}]
+        with self._lock:
+            os.makedirs(os.path.dirname(self.path), exist_ok=True)
+            with open(self.path, "a" if self._started else "w", newline="", encoding="utf-8") as stream:
+                writer = csv.writer(stream)
+                if not self._started:
+                    writer.writerow(self.FIELDS)
+                    self._started = True
+                for row in rows:
+                    writer.writerow([instant.isoformat(timespec="milliseconds"), event] +
+                                    ["" if row.get(name) is None else row.get(name)
+                                     for name in self.FIELDS[2:]])
+                    self.rows_written += 1
+                stream.flush()
+
+
